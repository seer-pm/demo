{
  "name": "@seer-pm/react",
  "version": "0.0.16",
  "description": "React hooks for the Seer prediction market protocol",
  "license": "MIT",
  "author": "Seer",
  "repository": {
    "type": "git",
    "url": "https://github.com/seer-pm/seer-pm.git",
    "directory": "packages/seer-pm-react"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./hooks/useAddV4Liquidity": {
      "types": "./dist/hooks/useAddV4Liquidity.d.ts",
      "import": "./dist/hooks/useAddV4Liquidity.mjs",
      "require": "./dist/hooks/useAddV4Liquidity.js"
    },
    "./hooks/useIsOrderBookPoolInitialized": {
      "types": "./dist/hooks/useIsOrderBookPoolInitialized.d.ts",
      "import": "./dist/hooks/useIsOrderBookPoolInitialized.mjs",
      "require": "./dist/hooks/useIsOrderBookPoolInitialized.js"
    },
    "./hooks/usePlaceV4LimitOrder": {
      "types": "./dist/hooks/usePlaceV4LimitOrder.d.ts",
      "import": "./dist/hooks/usePlaceV4LimitOrder.mjs",
      "require": "./dist/hooks/usePlaceV4LimitOrder.js"
    },
    "./hooks/useManageV4LimitOrders": {
      "types": "./dist/hooks/useManageV4LimitOrders.d.ts",
      "import": "./dist/hooks/useManageV4LimitOrders.mjs",
      "require": "./dist/hooks/useManageV4LimitOrders.js"
    },
    "./hooks/useUserV4Positions": {
      "types": "./dist/hooks/useUserV4Positions.d.ts",
      "import": "./dist/hooks/useUserV4Positions.mjs",
      "require": "./dist/hooks/useUserV4Positions.js"
    },
    "./hooks/useManageV4Positions": {
      "types": "./dist/hooks/useManageV4Positions.d.ts",
      "import": "./dist/hooks/useManageV4Positions.mjs",
      "require": "./dist/hooks/useManageV4Positions.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "tsup --config tsup.config.ts --watch",
    "prepublishOnly": "yarn build"
  },
  "peerDependencies": {
    "@seer-pm/contracts-ts": "*",
    "@seer-pm/order-book": "*",
    "@seer-pm/sdk": "~0.0.1",
    "@tanstack/react-query": ">=5.0.0",
    "@wagmi/core": ">=2.0.0",
    "react": ">=18.0.0",
    "viem": ">=2.0.0",
    "wagmi": ">=2.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18"
  }
}
