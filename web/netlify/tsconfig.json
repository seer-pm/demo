{
  "compilerOptions": {
    "esModuleInterop": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "target": "ES2021",
    "module": "ESNext",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "paths": {
      "@/*": ["../src/*"],
      "@seer-pm/sdk": ["../../packages/seer-pm-sdk/src/index.ts"],
      "@seer-pm/sdk/sign-in": ["../../packages/seer-pm-sdk/src/sign-in.ts"],
      "@seer-pm/react": ["../../packages/seer-pm-react/src/index.ts"],
      "@seer-pm/discussions": ["../../packages/seer-pm-discussions/src/index.ts"]
    }
  },
  "include": ["./functions/**/*", "../src"]
}
