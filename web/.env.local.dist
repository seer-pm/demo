VITE_WC_PROJECT_ID=
VITE_ADD_HARDHAT_NETWORK=

# Set to "true" to hide trading credits from the trading UI
# VITE_CREDITS_DISABLED=true
# Active credits profile: SEER_CREDITS (default) or OPPORTUNITY_CREDITS
# VITE_CREDITS_PROFILE=SEER_CREDITS

# Netlify functions (local dev via `netlify dev`)
# Required for admin "Get AI suggestions" in Major Events (xAI Grok API)
XAI_API_KEY=

# X (Twitter) account verification on /profile (OAuth 2.0 confidential client from developer.x.com)
X_CLIENT_ID=
X_CLIENT_SECRET=
# Must match a callback URL registered on the X app exactly
X_REDIRECT_URI=http://localhost:8888/.netlify/functions/x-callback
